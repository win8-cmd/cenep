# 默认按文本处理并统一换行为 LF（避免 Windows/Linux 混用时的整文件 diff）
* text=auto eol=lf

# 显式声明为文本
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.spec  text eol=lf

# 二进制文件（禁止换行转换与 diff）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.exe   binary
*.dll   binary
*.pyd   binary
*.nep   binary
